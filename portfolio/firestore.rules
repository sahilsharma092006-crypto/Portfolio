rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to your portfolio projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false; // Only update via Firebase Console or Admin
    }
    
    // Allow visitors to submit contact messages, but not read them
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
