rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is Sahil
    function isSahil() {
      return request.auth != null && request.auth.token.email == 'sahilsharma092006@gmail.com';
    }

    // Helper: Validate Project Schema
    function isValidProject() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 &&
             data.category is string &&
             data.year is string &&
             data.description is string &&
             data.tags is list &&
             data.images is map &&
             data.createdAt is timestamp;
    }

    match /projects/{project} {
      // Public read access for portfolio visibility
      allow read: if true;
      
      // Strict write access for Sahil only
      allow create: if isSahil() && isValidProject();
      allow update: if isSahil() && isValidProject();
      allow delete: if isSahil();
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}